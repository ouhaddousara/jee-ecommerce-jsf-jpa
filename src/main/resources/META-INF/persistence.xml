<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2"
             xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">

  <!--
    RESOURCE_LOCAL: Tomcat is not a JTA server, so the application manages its
    own transactions. JDBC URL, credentials, DDL mode and log level are NOT
    here: they come from db.properties (see PersistenceConfig).
  -->
  <persistence-unit name="ecommercePU" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

    <!-- Explicit list: classpath scanning is unreliable on Tomcat. -->
    <class>ma.fstt.entities.Internaute</class>
    <class>ma.fstt.entities.Client</class>
    <class>ma.fstt.entities.Administrateur</class>
    <class>ma.fstt.entities.Vitrine</class>
    <class>ma.fstt.entities.Categorie</class>
    <class>ma.fstt.entities.Produit</class>
    <class>ma.fstt.entities.Panier</class>
    <class>ma.fstt.entities.LignePanier</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>

    <!-- No shared (L2) cache: what you see in MySQL is what the application reads. -->
    <shared-cache-mode>NONE</shared-cache-mode>
    <!-- No Bean Validation provider on the classpath. -->
    <validation-mode>NONE</validation-mode>

    <properties>
      <property name="eclipselink.target-database" value="MySQL"/>
      <!-- No weaving agent on Tomcat: silences the related warnings. -->
      <property name="eclipselink.weaving" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
