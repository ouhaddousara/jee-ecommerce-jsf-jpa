<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>ecommerce-jsf-jpa</display-name>

  <!-- ===== JSF ===== -->
  <context-param>
    <!-- Development: detailed errors in the browser. Switch to Production for a release. -->
    <param-name>javax.faces.PROJECT_STAGE</param-name>
    <param-value>Development</param-value>
  </context-param>
  <context-param>
    <param-name>javax.faces.DEFAULT_SUFFIX</param-name>
    <param-value>.xhtml</param-value>
  </context-param>
  <context-param>
    <param-name>javax.faces.FACELETS_SKIP_COMMENTS</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <!-- The view state stays on the server (the page only carries an identifier). -->
    <param-name>javax.faces.STATE_SAVING_METHOD</param-name>
    <param-value>server</param-value>
  </context-param>

  <servlet>
    <servlet-name>FacesServlet</servlet-name>
    <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>FacesServlet</servlet-name>
    <url-pattern>*.xhtml</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>vitrine.xhtml</welcome-file>
  </welcome-file-list>

  <!--
    Filters are declared here (not with @WebFilter) because the order matters
    and annotations give no order: security first, then access control.
  -->
  <filter>
    <filter-name>SecurityFilter</filter-name>
    <filter-class>ma.fstt.web.SecurityFilter</filter-class>
  </filter>
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>ma.fstt.web.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>SecurityFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/panier.xhtml</url-pattern>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>

  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- The composite components are meant to be used by the pages, not opened by their address:
       an empty auth-constraint forbids direct HTTP access (JSF still loads them internally). -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>Composite components</web-resource-name>
      <url-pattern>/resources/components/*</url-pattern>
    </web-resource-collection>
    <auth-constraint/>
  </security-constraint>

  <error-page>
    <error-code>403</error-code>
    <location>/erreur.xhtml</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/erreur.xhtml</location>
  </error-page>
  <error-page>
    <error-code>405</error-code>
    <location>/erreur.xhtml</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/erreur.xhtml</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/erreur.xhtml</location>
  </error-page>

  <!-- CDI on Tomcat: JNDI entry matching META-INF/context.xml. Mojarra looks the BeanManager
       up there to resolve #{bean} expressions against CDI beans. -->
  <resource-env-ref>
    <resource-env-ref-name>BeanManager</resource-env-ref-name>
    <resource-env-ref-type>javax.enterprise.inject.spi.BeanManager</resource-env-ref-type>
  </resource-env-ref>
</web-app>
